ossorigin href=\"/_nuxt/CR2lZxZs.js\">\n<title>FabLang</title>\n<link rel=\"alternate\" href=\"https://fablang.acapela-group.com\" hreflang=\"x-default\">\n<link rel=\"alternate\" href=\"https://fablang.acapela-group.com\" hreflang=\"en\">\n<link rel=\"alternate\" href=\"https://fablang.acapela-group.com\" hreflang=\"en-US\">\n<link rel=\"canonical\" href=\"https://fablang.acapela-group.com\">\n<meta property=\"og:url\" content=\"https://fablang.acapela-group.com\">\n<meta property=\"og:locale\" content=\"en_US\">\n<script type=\"module\" src=\"/_nuxt/BXsFQ-nQ.js\" crossorigin></script></head><body  class=\"m-0 p-0 font-karla flex flex-col h-full\"><div id=\"__nuxt\" class=\"flex flex-col h-full\"><!--[--><header class=\"bg-bg-aca-primary sticky top-0 relative lg:items-center z-10 text-xl\"><div class=\"block lg:flex lg:justify-between items-center\"><div class=\"lg:shadow-none\"><div class=\"flex items-center justify-between container mx-auto\"><a aria-current=\"page\" href=\"/\" class=\"router-link-active router-link-exact-active text-3xl mx-4 py-6\" title=\"Go to homepage\"><img class=\"max-h-12\" src=\"/img/logo.svg\" alt=\"FabLang logo\"></a><nav class=\"lg:hidden flex\"><button type=\"button\" role=\"menu\" class=\"hover:cursor-pointer text-10 items-center bg-transparent border-none inline-flex max-lg:mx-2\"><span class=\"i-ph-list text-brand-deep-blue\"></span></button><a href=\"/user/signin\" class=\"lg:grid lg:items-center block p-2 inline-flex\" title=\"Sign In\"><span class=\"i-ph-user text-10 text-brand-deep-blue\"></span><span class=\"sr-only\">Sign In</span></a></nav></div></div><nav class=\"grid-rows-[0fr] grid lg:flex lg:border-none lg:self-stretch items-stretch lg:py-0 transition-all duration-400 ease-in-out overflow-hidden lg:overflow-inherit text-brand-deep-blue\"><div class=\"lg:flex lg:w-full text-end lg:text-start px-4 lg:px-0 overflow-hidden lg:overflow-inherit\"><!----><a href=\"/languages/listen\" class=\"[&amp;:not(:first-child)]:border-t-solid [&amp;:not(:first-child)]:border-t-1 border-t-#E5E5E5 lg:border-none lg:grid lg:items-center flex justify-end p-2 no-underline px-4\">Discover</a><a href=\"/tutorial\" class=\"[&amp;:not(:first-child)]:border-t-solid [&amp;:not(:first-child)]:border-t-1 border-t-#E5E5E5 lg:border-none lg:grid lg:items-center flex justify-end p-2 no-underline px-4\">Tutorial</a><a href=\"/news\" class=\"[&amp;:not(:first-child)]:border-t-solid [&amp;:not(:first-child)]:border-t-1 border-t-#E5E5E5 lg:border-none lg:grid lg:items-center flex justify-end p-2 no-underline px-4\">News</a><a href=\"/about\" class=\"[&amp;:not(:first-child)]:border-t-solid [&amp;:not(:first-child)]:border-t-1 border-t-#E5E5E5 lg:border-none lg:grid lg:items-center flex justify-end p-2 no-underline px-4\">About</a><a href=\"/support\" class=\"[&amp;:not(:first-child)]:border-t-solid [&amp;:not(:first-child)]:border-t-1 border-t-#E5E5E5 lg:border-none lg:grid lg:items-center flex justify-end p-2 no-underline px-4\">Support</a></div></nav><nav class=\"hidden lg:flex items-center gap-4 pr-4\"><a href=\"/user/signin\" class=\"lg:grid lg:items-center block p-2 no-underline px-4 bg-bg-aca-secondary rounded-full\">Sign In</a><a href=\"/user/signup\" class=\"lg:grid lg:items-center block p-2 no-underline px-4 bg-brand-primary rounded-full text-bg-aca-primary\">Sign Up</a></nav></div></header><main class=\"main-bg flex-1\"><div data-v-e90b5575><div class=\"sm:h-600px relative bg-bg-aca-secondary z-2\" data-v-e90b5575><div class=\"sm:absolute h-184px sm:h-full w-full overflow-hidden\" data-v-e90b5575><img src=\"/img/landing-cover.jpg\" alt=\"Woman wearing headset smiling.\" class=\"w-full h-full sm:translate-y--15% sm:scale-140 origin-center-center sm:origin-right-top object-cover\" data-v-e90b5575></div><div class=\"sm:absolute w-full sm:h-75% bg-brand-deep-blue sm:bg-transparent sm:bg-[url(/img/landing-cover-wave.svg)] bottom-0 sm:translate-y-85px bg-cover-full flex sm:flex-row-reverse items-center bg-size-100%\" data-v-e90b5575><div class=\"py-8 px-4 sm:p-0 sm:w-40% sm:mr-10% align-middle sm:mt-20\" data-v-e90b5575><span class=\"text-bg-aca-primary font-500 text-3xl lg:text-4xl xl:text-5xl\" data-v-e90b5575>Develop new languages, dialects and <!--[--><span class=\"font-quentin text-#FF6A6A text-5xl/0 lg:text-6xl/0 xl:text-7xl/0 align-baseline inline-block\" data-v-e90b5575>voices</span><!--]--> with AI</span></div></div></div><div class=\"bg-#F5F3EF sm:bg-transparent bg-[url(/img/landing-test-background.svg)] relative\" data-v-e90b5575><div class=\"absolute bg-[url(/img/landing-test-waves.svg)] bg-cover-full top-40% left-0 right-0 sm:inset-0 z-3 h-25% sm:h-full\" data-v-e90b5575></div><div class=\"grid sm:cols-2 sm:gap-48 container mx-auto pt-10 sm:pt-30 pb-20 sm:pb-30 relative z-3\" data-v-e90b5575><p class=\"text-2xl\" data-v-e90b5575>The recent innovations in AI and the massive deployment of voice technologies have considerably increased user expectations in terms of new usages, performance and personalization. But apart from the major international languages, the linguistic offer remains limited.</p><div class=\"mt-10 sm:mt-0\" data-v-e90b5575><h3 class=\"text-brand-primary text-3xl font-josefin font-400 mb-4\" data-v-e90b5575>Test our solution</h3><!----><div class=\"flex flex-col gap-2 items-stretch\" data-v-e90b5575><!----><label class=\"sr-only\" for=\"tts-prompt\">Text to play</label><textarea name=\"tts-prompt\" id=\"tts-prompt\" class=\"grow rounded-md py-2 px-4 border-1 border-solid border-#C9CCCF shadow-[0_1px_3px_0_#0000001F] resize-none font-karla text-lg\" rows=\"5\" maxlength=\"400\">Good morning! I&#39;m glad to meet you.</textarea><small class=\"text-#647E97 text-base\">35/400 characters</small><button class=\"border-none text-center text-base font-karla font-700 py-2 rounded-md bg-brand-primary text-bg-aca-primary hover:cursor-pointer inline-flex items-center justify-center disabled:opacity-50 disabled:hover:cursor-not-allowed sm:w-50%\" type=\"button\"><!----><span class=\"\">Play</span><!----></button></div></div></div></div><div class=\"bg-bg-aca-primary sm:bg-transparent container mx-auto pt-10 sm:pt-0 mb-10 sm:mb-20\" data-v-e90b5575><h3 class=\"text-brand-primary text-6xl font-josefin font-400 mb-4\" data-v-e90b5575>How it works</h3><div class=\"flex flex-col sm:flex-row items-center sm:items-start justify-evenly flex-wrap\" data-v-e90b5575><div class=\"flex flex-col max-w-200px\" data-v-e90b5575><img class=\"h-200px\" src=\"/img/speech-bubble-1.svg\" alt=\"Speech bubble\"><span class=\"text-center\"><!--[--><span class=\"\" data-v-e90b5575>Data upload : Please upload audio data and their respective transcription. This will be used by our algorithms for TTS system adaptation. Please be careful about the <!--[--><a href=\"/legal\" rel=\"noopener noreferrer\" target=\"_blank\" class=\"text-brand-primary font-700 underline\" data-v-e90b5575>User Confirmation of Rights</a><!--]--></span><!--]--></span></div><div class=\"flex flex-col max-w-200px\" data-v-e90b5575><img class=\"h-200px\" src=\"/img/speech-bubble-2.svg\" alt=\"Speech bubble\"><span class=\"text-center\"><!--[-->Data validation : The data is analyzed and verified automatically and if needed manually.<!--]--></span></div><div class=\"flex flex-col max-w-200px\" data-v-e90b5575><img class=\"h-200px\" src=\"/img/speech-bubble-3.svg\" alt=\"Speech bubble\"><span class=\"text-center\"><!--[-->Model adaptation : Our model is then trained or adapted on the provided data. This step is very dependent of the provided data, it could last from few hours to few days depending on the quality and size of the uploaded data.<!--]--></span></div><div class=\"flex flex-col max-w-200px\" data-v-e90b5575><img class=\"h-200px\" src=\"/img/speech-bubble-4.svg\" alt=\"Speech bubble\"><span class=\"text-center\"><!--[-->Once training is made, the model is available for test in a type and talk interface. Feedback may be given by users.<!--]--></span></div></div><div class=\"flex items-center justify-center mt-5 sm:mt-20\" data-v-e90b5575><button class=\"border-none text-center text-base font-karla font-700 py-2 rounded-md bg-brand-primary text-bg-aca-primary hover:cursor-pointer inline-flex items-center justify-center disabled:opacity-50 disabled:hover:cursor-not-allowed sm:px-20 grow sm:grow-0\" type=\"button\" data-v-e90b5575><!----><span class=\"\">Watch our tutorial</span><!----></button></div></div><div class=\"sm:px-20%\" data-v-e90b5575><div class=\"container mx-auto\" data-v-e90b5575><h3 class=\"text-brand-primary text-6xl font-josefin font-400 mb-4\">News</h3><article class=\"sm:grid sm:cols-3 mt-10 sm:mt-20\"><span class=\"text-brand-deep-blue font-700 sm:border-r-solid sm:border-r-2px sm:border-r-#F5F5F5 mr-4\">February 2025</span><div class=\"sm:col-span-2\"><h4 class=\"text-brand-primary text-2xl font-josefin font-400 mt-0 mb-4\">Release of the platform</h4><div><!--[--><p>Version 1.0 of the FabLang platform is out now. You have now the ability to create a TTS language by just uploading audio files and their transcription on the platform.</p><!--]--></div></div></article><div class=\"flex items-center justify-center mt-5 sm:mt-20\"><button class=\"border-none text-center text-base font-karla font-700 py-2 rounded-md bg-brand-deep-blue text-bg-aca-primary hover:cursor-pointer inline-flex items-center justify-center disabled:opacity-50 disabled:hover:cursor-not-allowed sm:px-20 grow sm:grow-0\" type=\"button\"><!----><span class=\"\">All news</span><!----></button></div></div></div><div class=\"bg-[url(/img/landing-test-waves.svg)] bg-[position:center_top_20rem] sm:bg-[position:center_top_15rem] bg-[length:100%_300px] bg-no-repeat sm:py-30 my-10\" data-v-e90b5575><div class=\"sm:px-20%\" data-v-e90b5575><div class=\"container mx-auto\" data-v-e90b5575><h3 class=\"text-brand-primary text-6xl font-josefin font-400 mb-4\">FAQ</h3><div class=\"pb-4\"><div class=\"flex items-center border-b-2px border-b-solid border-b-#F5F5F5 hover:cursor-pointer\"><span class=\"text-xl grow py-2\">How can I register ?</span><span class=\"i-ph-caret-down shrink text-brand-primary text-3xl transition\"></span></div><div class=\"grid-rows-[0fr] transition-all grid ease-in-out duration-400\" aria-expanded=\"false\"><div class=\"overflow-hidden\"><!--[--><p>Please use the following <a href=\"/user/signup\" class=\"text-brand-primary\">sign up</a> page and enter a valid email, name, and entity information.</p><!--]--></div></div></div><div class=\"pb-4\"><div class=\"flex items-center border-b-2px border-b-solid border-b-#F5F5F5 hover:cursor-pointer\"><span class=\"text-xl grow py-2\">What data is needed to create a new language ?</span><span class=\"i-ph-caret-down shrink text-brand-primary text-3xl transition\"></span></div><div class=\"grid-rows-[0fr] transition-all grid ease-in-out duration-400\" aria-expanded=\"false\"><div class=\"overflow-hidden\"><!--[--><p>Two types of data are primarily needed: audio data and their transcriptions, which are required for model training and adaptation. A minimum of 1 hour of data is required to create a system, but naturally, the more data the system receives, the better its performance in terms of naturalness.</p><!--]--></div></div></div><div class=\"pb-4\"><div class=\"flex items-center border-b-2px border-b-solid border-b-#F5F5F5 hover:cursor-pointer\"><span class=\"text-xl grow py-2\">Data property</span><span class=\"i-ph-caret-down shrink text-brand-primary text-3xl transition\"></span></div><div class=\"grid-rows-[0fr] transition-all grid ease-in-out duration-400\" aria-expanded=\"false\"><div class=\"overflow-hidden\"><!--[--><p>Please ensure that you have the necessary rights and permissions to use the audio and text files uploaded to our system, and that the materials provided do not infringe on any copyrights, intellectual property, or other legal rights of third parties.</p><!--]--></div></div></div><div class=\"pb-4\"><div class=\"flex items-center border-b-2px border-b-solid border-b-#F5F5F5 hover:cursor-pointer\"><span class=\"text-xl grow py-2\">What are the available languages ?</span><span class=\"i-ph-caret-down shrink text-brand-primary text-3xl transition\"></span></div><div class=\"grid-rows-[0fr] transition-all grid ease-in-out duration-400\" aria-expanded=\"false\"><div class=\"overflow-hidden\"><!--[--><p>For demonstration purposes, only US English is available. However, when logging in, there are no limitations on the languages that can be developed, as long as you have sufficient data to train/adapt the model.</p><!--]--></div></div></div><div class=\"pb-4\"><div class=\"flex items-center border-b-2px border-b-solid border-b-#F5F5F5 hover:cursor-pointer\"><span class=\"text-xl grow py-2\">Commercial exploitation</span><span class=\"i-ph-caret-down shrink text-brand-primary text-3xl transition\"></span></div><div class=\"grid-rows-[0fr] transition-all grid ease-in-out duration-400\" aria-expanded=\"false\"><div class=\"overflow-hidden\"><!--[--><p>Any commercial use of the generated TTS audio files is not authorized. If you intend to use the files for commercial purposes, please contact us at frontdesk@acapela-group.com for the appropriate licensing arrangements.</p><!--]--></div></div></div></div></div></div><div class=\"container mx-auto pb-20 max-sm:max-w-400px\" data-v-e90b5575><div class=\"relative sm:mx-10% md:mx-15% h-auto sm:h-175px lg:h-200px xl:h-250px 2xl:h-300px overflow-hidden\" data-v-e90b5575><div class=\"sm:absolute inset-0 z-1 h-290px sm:h-auto\" data-v-e90b5575><img src=\"/img/landing-banner-image-desktop.png\" alt=\"Woman smiling\" class=\"h-full w-auto object-cover origin-top-center\" data-v-e90b5575></div><div class=\"sm:absolute h-267px sm:h-auto bg-[url(/img/landing-banner-mobile.svg)] sm:bg-[url(/img/landing-banner-desktop.svg)] inset-0 bg-cover sm:bg-no-repeat sm:bg-[length:60%_full] bg-right z-2 flex-col sm:flex-row flex items-center justify-evenly xl:gap-40\" data-v-e90b5575><div class=\"z-3 xl:px-5\" data-v-e90b5575><span class=\"text-bg-aca-primary font-500 text-2xl inline-flex flex-col lg:pt-10 xl:pt-15\" data-v-e90b5575>Create your own <!--[--><span class=\"font-quentin text-white text-6xl lg:text-7xl xl:text-8xl align-baseline inline-block rotate-356.5 sm:ml-5\" data-v-e90b5575>language</span><!--]--></span></div><button class=\"border-none text-center text-xl font-karla font-700 py-2 px-6 rounded-full bg-white text-#FF1414 hover:cursor-pointer inline-flex items-center justify-center disabled:opacity-50 disabled:hover:cursor-not-allowed z-3 sm:mt-10 lg:mt-20\" type=\"button\" data-v-e90b5575><!----><span class=\"\">Sign up now</span><!----></button></div></div></div></div></main><div><div class=\"sm:bg-[url(/img/wave-footer.svg)] sm:min-h-417px sm:bg-no-repeat sm:bg-cover-full\" data-v-58a1e3bb><div class=\"flex flex-wrap justify-between h-full\" data-v-58a1e3bb><div class=\"grid sm:cols-2 container mx-auto sm:px-10% pb-10\" data-v-58a1e3bb><div class=\"flex flex-col sm:max-w-100 items-start gap-4 py-4\" data-v-58a1e3bb><img class=\"max-h-9\" src=\"/img/logo.svg\" alt=\"FabLang logo\" data-v-58a1e3bb><div data-v-58a1e3bb><span class=\"sm:text-xl text-brand-deep-blue\" data-v-58a1e3bb>We create personalized voices that bring value to all services, applications or devices that need to <!--[--><span class=\"font-quentin text-brand-primary text-7 sm:text-9 leading-0 inline-block align-baseline\" data-v-58a1e3bb>speak</span><!--]--></span></div><a href=\"/about\" class=\"text-brand-deep-blue bg-#F5F5F5 px-4 py-2 rounded-md font-700 text-sm text-center w-full sm:w-auto\" data-v-58a1e3bb>About us</a></div></div><div class=\"w-full text-right pt-0 sm:pt-20 sm:pr-10% lg:pr-20%\" data-v-58a1e3bb><a class=\"text-bg-aca-primary sm:text-sm no-underline sm:ml-auto inline-flex gap-2 items-center w-full sm:w-auto justify-center sm:mb-40 p-8 sm:p-0 bg-#252757 sm:bg-transparent\" href=\"#\" data-v-58a1e3bb><span data-v-58a1e3bb>Back to top</span><spa