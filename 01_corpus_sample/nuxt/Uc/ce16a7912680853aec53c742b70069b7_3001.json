-3.png 2x\" onerror=\"this.setAttribute(&#39;data-error&#39;, 1)\" alt=\"Dog Yairo\" class=\"w-full max-w-lg object-contain mask-image-bottom opacity-90\" style=\"mask-image:linear-gradient(to bottom, black 70%, transparent 100%);-webkit-mask-image:linear-gradient(to bottom, black 70%, transparent 100%);\" src=\"/_ipx/_/img/dog-yairo-3.png\"></div></div></section><section class=\"scroll-section animate-about relative min-h-screen snap-start snap-always flex items-center py-24 md:py-32 overflow-hidden bg-black\"><div class=\"absolute opacity-90 pointer-events-none z-0\" style=\"top:9svh;left:27svw;width:38svw;\"><img data-nuxt-img srcset=\"/_ipx/_/img/logo-lines.svg 1x, /_ipx/_/img/logo-lines.svg 2x\" onerror=\"this.setAttribute(&#39;data-error&#39;, 1)\" alt=\"Dog Yairo Lines\" class=\"w-full h-auto\" src=\"/_ipx/_/img/logo-lines.svg\"></div><div class=\"container relative z-10 px-6 md:px-12 lg:px-24\"><div class=\"flex flex-col md:flex-row items-center gap-12 lg:gap-24\"><div class=\"w-full md:w-1/2 relative flex justify-start\" style=\"margin-left:-6rem;\"><img data-nuxt-img srcset=\"/_ipx/_/img/dog-yairo-2.png 1x, /_ipx/_/img/dog-yairo-2.png 2x\" onerror=\"this.setAttribute(&#39;data-error&#39;, 1)\" alt=\"Dog Yairo\" class=\"w-full max-w-2xl grayscale contrast-125 opacity-90\" style=\"mask-image:linear-gradient(to bottom, black 80%, transparent 100%);-webkit-mask-image:linear-gradient(to bottom, black 80%, transparent 100%);\" src=\"/_ipx/_/img/dog-yairo-2.png\"></div><div class=\"w-full md:w-1/2 text-right flex flex-col items-end\"><div class=\"mb-8 opacity-0\"><h2 class=\"font-script text-brand-500 transform -rotate-2 inline-block\" style=\"font-size:130px;line-height:1;\"> Mi Historia </h2></div><div class=\"opacity-0 flex flex-col items-end\"><p class=\"text-gray-300 mb-10 leading-relaxed font-light max-w-md text-right\" style=\"font-size:20px;\"> Soy artista urbano nacido en Managua, Nicaragua. Desde su adolescencia se radicó en Puerto Rico, en el residencial Juan Mato de Cataño, donde formó su familia y unió su sangre nica con la boricua, dando inicio a una identidad musical única. </p><button class=\"bg-brand-500 hover:bg-brand-600 text-white px-8 py-3 rounded-full font-bold tracking-wider text-xs transition-colors duration-300\"> VER MI HISTORIA </button></div></div></div></div></section><div class=\"relative\"><div class=\"absolute inset-0 pointer-events-none z-0 flex items-center justify-end overflow-hidden\"><img data-nuxt-img srcset=\"/_ipx/_/img/dog-bg.png 1x, /_ipx/_/img/dog-bg.png 2x\" onerror=\"this.setAttribute(&#39;data-error&#39;, 1)\" alt class=\"h-2/4 w-auto max-w-none opacity-10\" src=\"/_ipx/_/img/dog-bg.png\"></div><section class=\"scroll-section animate-disco min-h-screen snap-start snap-always flex items-center py-24 bg-transparent relative z-10\"><div class=\"container px-6 md:px-12 lg:px-24\"><div class=\"text-center mb-20 opacity-0 break-words\"><h2 class=\"text-4xl sm:text-5xl md:text-7xl lg:text-[90px] font-black tracking-widest mb-0 text-gray-300 leading-none\"> DISCOGRAFÍA</h2><h3 class=\"text-6xl sm:text-7xl md:text-8xl lg:text-[130px] font-script text-brand-500 -mt-8 md:-mt-16 transform -rotate-2 leading-none\"> Musica Real</h3></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mb-16\"><!--[--><div class=\"disco-item opacity-0 group cursor-pointer\"><div class=\"relative aspect-square overflow-hidden mb-6 rounded-sm\"><img data-nuxt-img srcset=\"/_ipx/_/img/30-caras-single.jpg 1x, /_ipx/_/img/30-caras-single.jpg 2x\" onerror=\"this.setAttribute(&#39;data-error&#39;, 1)\" alt=\"30 CARAS\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" src=\"/_ipx/_/img/30-caras-single.jpg\"><div class=\"absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-500\"></div></div><h4 class=\"text-3xl font-bold tracking-wider text-left\">30 CARAS</h4></div><div class=\"disco-item opacity-0 group cursor-pointer\"><div class=