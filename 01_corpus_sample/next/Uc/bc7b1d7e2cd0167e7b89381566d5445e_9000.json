\"/styles/style.css\"/><link rel=\"stylesheet\" href=\"/styles/custom.css\"/><script src=\"/_next/static/chunks/a6dad97d9634a72d.js\" noModule=\"\"></script></head><body class=\"theme-dark\"><div hidden=\"\"><!--$--><!--/$--></div><div id=\"page\"><header class=\"finooma-header shadow-xl\"><div class=\"finooma-header__inner \"><a class=\"finooma-logo \" aria-label=\"خانه فینـوما\" href=\"/\"><span class=\"finooma-logo__mark\">F</span><span class=\"finooma-logo__text\">فینـوما</span></a><nav class=\"finooma-nav \" aria-label=\"منوی اصلی\"><a class=\"finooma-nav__item is-active\" href=\"/\">خانه</a><a class=\"finooma-nav__item \" href=\"/how-it-works\">چطور کار می‌کند</a><a class=\"finooma-nav__item \" href=\"/pricing\">اشتراک‌ها</a><a class=\"finooma-nav__item \" href=\"/portfolio-builder\">تولید پرتفوی</a><a class=\"finooma-nav__item \" href=\"/about\">درباره فینـوما</a><a class=\"finooma-nav__item d-lg-none \" href=\"/login\">ورود</a><a class=\"btn btn-sm gradient-highlight finooma-nav__cta\" href=\"/register\">ثبت نام</a></nav><div class=\"finooma-header__cta \"><button type=\"button\" class=\"finooma-theme-toggle is-dark\" aria-label=\"تغییر به حالت روشن\"><span class=\"finooma-theme-toggle__icon\" aria-hidden=\"true\"><i class=\"fa fa-moon\"></i></span><span class=\"finooma-theme-toggle__track\"><span class=\"finooma-theme-toggle__thumb\"></span></span></button><a class=\"btn btn-sm btn-outline-secondary d-none d-md-inline-flex\" href=\"/login\">ورود</a><button type=\"button\" class=\"finooma-nav__toggle \" aria-label=\"باز کردن منو\"><span></span><span></span><span></span></button></div></div><div class=\"finooma-nav__overlay \"></div></header><main class=\"page-shell\"><div class=\"finooma-home\"><section class=\"finooma-hero\" id=\"hero\"><div class=\"finooma-hero__content\"><span class=\"finooma-badge\"><i class=\"fa fa-star\"></i>پلتفرم جامع مدیریت سرمایه</span><h1 class=\"finooma-hero__title\">هوشمندانه‌ترین راه برای ساخت پرتفوی شخصی شما</h1><p class=\"finooma-hero__description\">فینـوما با ترکیب تحلیل داده‌های لحظه‌ای و تجربه سبدگردان‌های حرفه‌ای، بهترین ترکیب دارایی را برای رسیدن به اهداف مالی شما می‌چیند. از بازار بورس تهران تا طلا و رمزارز، همه در دسترس شماست.</p><div class=\"finooma-hero__actions\"><a class=\"btn btn-lg gradient-highlight\" href=\"/portfolio-builder\">همین حالا پرتفوی بسازید</a><a class=\"btn btn-lg btn-outline-light\" href=\"/how-it-works\">آشنایی با مراحل کار</a></div><div class=\"finooma-stats\"><div class=\"finooma-stat\"><strong>+۵۰۰</strong><span>سرمایه‌گذار فعال</span></div><div class=\"finooma-stat\"><strong>۹۸٪</strong><span>نرخ رضایت مشتری</span></div><div class=\"finooma-stat\"><strong>۸۷٪</strong><span>دقت انتخاب دارایی</span></div><div class=\"finooma-stat\"><strong>بورس، طلا، کریپتو</strong><span>بازارهای پوشش داده‌شده</span></div></div></div><div class=\"finooma-hero__illustration\" aria-hidden=\"true\"><img alt=\"سرمایه‌گذاری هوشمند\" width=\"520\" height=\"520\" decoding=\"async\" data-nimg=\"1\" class=\"finooma-hero__image\" style=\"color:transparent\" src=\"/images/banner.png\"/></div></section><section class=\"finooma-section\"><div class=\"finooma-section__header\"><span class=\"finooma-badge\"><i class=\"fa fa-shield-check\"></i>چرا فینـوما</span><h2>چرا سرمایه‌گذاران به فینـوما اعتماد می‌کنند؟</h2><p>زیرساخت داده‌محور پلتفرم در کنار تیم سبدگردانی ما، تجربه‌ای امن و شفاف برای ساخت و نگهداری پرتفوی به شما ارائه می‌دهد.</p></div><div class=\"finooma-feature-grid\"><div class=\"finooma-card\"><div class=\"mb-3\"><span class=\"finooma-timeline__icon\"><i class=\"fa fa-chart-line\"></i></span></div><h3>تحلیل لحظه‌ای و چندبعدی</h3><p>موتور تحلیل فینـوما داده‌های قیمتی، نوسان، مومنتوم و شاخص‌های ریسک را به‌صورت لحظه‌ای پایش می‌کند تا تصمیم‌های شما بر پایه اطلاعات به‌روز باشد.</p></div><div class=\"finooma-card\"><div class=\"mb-3\"><span class=\"finooma-timeline__icon\"><i class=\"fa fa-bullseye\"></i></span></div><h3>هماهنگی با سطح ریسک شما</h3><p>سه پروفایل ریسک، محدودیت سرمایه و بازه نگهداری به شما اجازه می‌دهد دقیقاً بر اساس هدف و اشتراک خود پرتفوی دریافت کنید.</p></div><div class=\"finooma-card\"><div class=\"mb-3\"><span class=\"finooma-timeline__icon\"><i class=\"fa fa-user-shield\"></i></span></div><h3>پشتیبانی تیم سبدگردان</h3><p>پس از تولید پرتفوی، تیم سبدگردانی فینـوما ترکیب پیشنهادی را بررسی و اجرای سفارش‌ها را برای شما مدیریت می‌کند.</p></div><div class=\"finooma-card\"><div class=\"mb-3\"><span class=\"finooma-timeline__icon\"><i class=\"fa fa-bell\"></i></span></div><h3>گزارش‌گیری و رصد مداوم</h3><p>داشبورد رصد عملکرد، هشدارهای ریسک و گزارش‌های مقایسه‌ای به شما کمک می‌کند همیشه یک گام جلوتر باشید.</p></div></div></section><section class=\"finooma-section finooma-section--alt\"><div class=\"finooma-section__header\"><span class=\"finooma-badge\"><i class=\"fa fa-route\"></i>مسیر قدم‌به‌قدم</span><h2>فرآیند تولید و اجرای پرتفوی در فینـوما</h2><p>با طی کردن چهار گام ساده، از انتخاب اشتراک تا اجرای معاملات، یک تجربه کامل مدیریت سرمایه در اختیار شما قرار می‌گیرد.</p></div><div class=\"finooma-timeline\"><div class=\"finooma-timeline__item\"><span class=\"finooma-timeline__icon\"><i class=\"fa fa-layer-group\"></i></span><div class=\"finooma-timeline__content\"><h3>انتخاب پلن و ثبت‌نام</h3><p>اشتراک عادی یا VIP را فعال کنید و دسترسی کامل پنل پرتفوی را دریافت کنید.</p></div></div><div class=\"finooma-timeline__item\"><span class=\"finooma-timeline__icon\"><i class=\"fa fa-sliders\"></i></span><div class=\"finooma-timeline__content\"><h3>تعریف هدف سرمایه‌گذاری</h3><p>ریسک، بازده مورد انتظار، سقف سرمایه و بازه نگهداری را ثبت کنید تا موتور تحلیل آغاز به کار کند.</p></div></div><div class=\"finooma-timeline__item\"><span class=\"finooma-timeline__icon\"><i class=\"fa fa-robot\"></i></span><div class=\"finooma-timeline__content\"><h3>تولید هوشمند پرتفوی</h3><p>پورتفوی پیشنهادی با وزن‌دهی، شاخص‌های ریسک/بازده و توضیحات تکمیلی تحویل شما می‌شود.</p></div></div><div class=\"finooma-timeline__item\"><span class=\"finooma-timeline__icon\"><i class=\"fa fa-clipboard-check\"></i></span><div class=\"finooma-timeline__content\"><h3>اجرا و پایش</h3><p>تیم سبدگردانی فینـوما معاملات را انجام می‌دهد و وضعیت پرتفوی را دائماً پایش می‌کند.</p></div></div></div></section><section class=\"finooma-section\"><div class=\"finooma-section__header\"><span class=\"finooma-badge\"><i class=\"fa fa-crown\"></i>پلن‌های اشتراک</span><h2>پلنی را انتخاب کنید که با استراتژی سرمایه‌گذاری شما همخوان است</h2><p>تمام پلن‌ها شامل دسترسی به موتور تولید پرتفوی و پشتیبانی کارشناسان فینـوما هستند. تفاوت اصلی در تعداد پرتفوی قابل تولید و سطح خدمات سبدگردانی است.</p></div><div class=\"finooma-pricing-grid\"><div class=\"finooma-pricing-card\"><div><h3>اشتراک عادی</h3><strong>۲۹۹ هزار تومان / ماه</strong></div><ul><li>تولید یک پرتفوی در ماه</li><li>پایش هفتگی ترکیب دارایی</li><li>گزارش عملکرد ماهانه</li></ul><a class=\"btn btn-lg gradient-highlight\" href=\"/pricing\">دریافت اشتراک عادی</a></div><div class=\"finooma-pricing-card finooma-pricing-card--highlight\"><div><h3>اشتراک VIP</h3><strong>۱٬۴۹۰ هزار تومان / ماه</strong></div><ul><li>تولید نامحدود پرتفوی</li><li>پایش لحظه‌ای و هشدار ریسک</li><li>همراهی اختصاصی سبدگردان</li></ul><a class=\"btn btn-lg gradient-highlight\" href=\"/pricing\">درخواست مشاوره VIP</a></div></div></section><section class=\"finooma-section finooma-section--alt\"><div class=\"finooma-section__header\"><span class=\"finooma-badge\"><i class=\"fa fa-comments\"></i>نظر مشتریان</span><h2>سرمایه‌گذاران چه می‌گویند؟</h2><p>تجربه کاربران فینـوما نشان می‌دهد ترکیب تکنولوژی و سبدگردانی انسانی، کارایی بالایی در مدیریت ریسک و خلق بازده دارد.</p></div><div class=\"finooma-testimonials\"><div class=\"finooma-testimonial\"><p>“<!-- -->با اشتراک VIP فینـوما به‌راحتی می‌توانم چندین پرتفوی مخصوص اهداف مختلف ایجاد کنم و تیم پشتیبانی واقعاً پیگیر اجرا است.<!-- -->”</p><div class=\"finooma-testimonial__author\"><span class=\"finooma-testimonial__avatar\">ب</span><div><strong>بهاره موسوی</strong><div class=\"text-muted small\">سرمایه‌گذار حقیقی</div></div></div></div><div class=\"finooma-testimonial\"><p>“<!-- -->گزارش‌های تحلیلی و کنترل ریسک فینـوما باعث شد دارایی نقد شرکت را با اطمینان وارد بازار کنیم و نتیجه عالی بگیریم.<!-- -->”</p><div class=\"finooma-testimonial__author\"><span class=\"finooma-testimonial__avatar\">ا</span><div><strong>امین رستمی</strong><div class=\"text-muted small\">مدیر مالی شرکت بازرگانی</div></div></div></div><div class=\"finooma-testimonial\"><p>“<!-- -->با پلن عادی هر ماه یک پرتفوی شخصی‌سازی شده می‌گیرم و دیگر نگران نوسانات شدید بازار نیستم.<!-- -->”</p><div class=\"finooma-testimonial__author\"><span class=\"finooma-testimonial__avatar\">س</span><div><strong>سمیه احمدی</strong><div class=\"text-muted small\">سرمایه‌گذار تازه‌کار</div></div></div></div></div></section><section class=\"finooma-section\"><div class=\"finooma-card text-center\" style=\"border-radius:28px\"><h2 class=\"mb-3\">آماده‌اید پرتفوی هوشمند خود را بسازید؟</h2><p class=\"mb-4\">روی دکمه زیر کلیک کنید، مشخصات هدف سرمایه‌گذاری را وارد کنید و بقیه مسیر را به فینـوما بسپارید.</p><div class=\"d-flex flex-wrap gap-3 justify-content-center\"><a class=\"btn btn-lg gradient-highlight\" href=\"/portfolio-builder\">تولید پرتفوی جدید</a><a class=\"btn btn-lg btn-outline-primary\" href=\"/pricing\">مقایسه پلن‌های اشتراک</a></div></div></section></div><!--$--><!--/$--></main><nav id=\"footer-bar\" class=\"footer-bar-6 d-lg-none\"><a aria-label=\"راهنما\" href=\"/how-it-works\"><i class=\"fa fa-compass\" aria-hidden=\"true\"></i><span>راهنما</span><em aria-hidden=\"true\"></em></a><a aria-label=\"اشتراک‌ها\" href=\"/pricing\"><i class=\"fa fa-gem\" aria-hidden=\"true\"></i><span>اشتراک‌ها</span><em aria-hidden=\"true\"></em></a><a class=\"circle-nav active-nav\" aria-label=\"خانه\" href=\"/\"><strong aria-hidden=\"true\"></strong><i class=\"fas fa-home\" aria-hidden=\"true\"></i><span>خانه</span><em aria-hidden=\"true\"></em></a><a aria-label=\"پرتفوی\" href=\"/portfolio-builder\"><i class=\"fa fa-chart-line\" 