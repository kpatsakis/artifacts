    "html": "<!DOCTYPE html><!--LrumNrJcUiTTHqCUPjJEi--><html lang=\"en\" class=\"__variable_c8454b __variable_37ef13\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/313510e2713fb214-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/e4af272ccee01ff0-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"/daria-kruglova.png\"/><link rel=\"stylesheet\" href=\"/_next/static/css/4627ea4203f5f72e.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-b253b1f7de05cacb.js\"/><script src=\"/_next/static/chunks/52f589e1-e75d940ab41796f4.js\" async=\"\"></script><script src=\"/_next/static/chunks/294-212db277c52adb66.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-4519dbe7c084c18b.js\" async=\"\"></script><script src=\"/_next/static/chunks/348-0cb60b64ac93a7af.js\" async=\"\"></script><script src=\"/_next/static/chunks/303-38238a802a5076ef.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-023040f84e111d36.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>JetBridge — Senior Engineer Network</title><meta name=\"description\" content=\"An invite-only network where seed-stage and VC-backed founders hire senior software engineers. Apply in a few minutes.\"/><link rel=\"icon\" href=\"/jetbridge-ai-logo.png\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div id=\"top\" class=\"min-h-screen bg-ivory\"><main><section class=\"wash-clinic relative overflow-hidden\"><div class=\"mx-auto max-w-operatory px-5 pb-12 pt-12 sm:px-8 sm:pt-16 lg:pb-20\"><div class=\"grid items-start gap-8 lg:grid-cols-2 lg:gap-12\"><div class=\"stagger\"><span class=\"eyebrow inline-flex items-center gap-2 rounded-pill bg-card px-3 py-1 shadow-e1\" style=\"animation-delay:0ms\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z\"></path><path d=\"M20 3v4\"></path><path d=\"M22 5h-4\"></path><path d=\"M4 17v2\"></path><path d=\"M5 18H3\"></path></svg>Invite-only talent representation</span><h1 class=\"mt-5 text-balance font-display text-[clamp(2.1rem,5vw,3.25rem)] font-bold leading-[1.08] text-charcoal\" style=\"animation-delay:80ms\">Make More Money With Less Hassle</h1><p class=\"mt-4 max-w-[44ch] text-base leading-relaxed text-muted\" style=\"animation-delay:120ms\">We&#x27;re a private network where seed-stage / VC-backed founders hire<!-- --> <strong class=\"text-charcoal font-semibold\">senior software engineers</strong> <!-- -->who want side projects or want more AI/ML/Data experience.</p><div class=\"mt-6 flex flex-wrap gap-3\" style=\"animation-delay:160ms\"><span class=\"inline-flex items-center gap-2 rounded-pill bg-mint-deep px-4 py-2 text-sm font-medium text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-4 w-4\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Free to Join</span><span class=\"inline-flex items-center gap-2 rounded-pill border border-charcoal/20 bg-card px-4 py-2 text-sm font-medium text-charcoal\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lock h-4 w-4\" aria-hidden=\"true\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg>Invite Only</span></div><div class=\"mt-10\" style=\"animation-delay:200ms\"><p class=\"max-w-[46ch] text-[15px] leading-relaxed text-charcoal\"></p><ul class=\"mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2\"><li class=\"flex items-start gap-2.5\"><span class=\"mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-pill bg-mint-soft\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles h-3.5 w-3.5 text-mint-deep\" aria-hidden=\"true\"><path d=\"M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z\"></path><path d=\"M20 3v4\"></path><path d=\"M22 5h-4\"></path><path d=\"M4 17v2\"></path><path d=\"M5 18H3\"></path></svg></span><span class=\"text-sm leading-snug text-charcoal\">Fast interview — 20 friendly minutes, not 6 rounds</span></li><li class=\"flex items-start gap-2.5\"><span class=\"mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-pill bg-mint-soft\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-3.5 w-3.5 text-mint-deep\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></span><span class=\"text-sm leading-snug text-charcoal\">Clean KYC — minimal bureaucracy</span></li><li class=\"flex items-start gap-2.5\"><span class=\"mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-pill bg-mint-soft\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-3.5 w-3.5 text-mint-deep\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg></span><span class=\"text-sm leading-snug text-charcoal\">Screened clients — vetted, funded, serious</span></li><li class=\"flex items-start gap-2.5\"><span class=\"mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-pill bg-mint-soft\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trending-up h-3.5 w-3.5 text-mint-deep\" aria-hidden=\"true\"><polyline points=\"22 7 13.5 15.5 8.5 10.5 2 17\"></polyline><polyline points=\"16 7 22 7 22 13\"></polyline></svg></span><span class=\"text-sm leading-snug text-charcoal\">Advocacy on comp, visa, and equity</span></li></ul></div><div class=\"mt-8 space-y-5 border-t border-line pt-8\" style=\"animation-delay:240ms\"><div class=\"rounded-lg bg-mint-soft/30 p-4 border-l-4 border-mint-deep\"><p class=\"text-[15px] leading-relaxed text-charcoal font-medium\">We founded 3 startups (1 IPO, 1 cash exit, 1 bootstrap profitable) and we did it by putting developers first.</p></div><div class=\"pl-4 border-l-2 border-gray/30\"><p class=\"text-[15px] leading-relaxed text-muted italic\">Einstein said &quot;Genius is 1% inspiration and 99% perspiration&quot; and our belief is that software engineers are that 99%. That&#x27;s what most unsuccessful startup founders don&#x27;t understand.</p></div><p class=\"text-[15px] leading-relaxed text-muted\">It&#x27;s also true that vibe coding founders who think they can pay someone $500 to commercialize their app are fools, and developers who can&#x27;t reverse a string aren&#x27;t real engineers.</p><div class=\"rounded-lg bg-card p-4 shadow-e1\"><p class=\"text-[15px] leading-relaxed text-charcoal font-semibold text-center\">So we hire for real engineers. And treat them like gold.</p></div><div class=\"flex gap-3\"><div class=\"mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-charcoal/10\"><span class=\"text-xs text-charcoal\">1</span></div><p class=\"text-[15px] leading-relaxed text-muted\">We don&#x27;t use &quot;AI&quot; to match you with client projects - we have a team of senior recruiters and tech leads who vet every client by phone call before introducing you.</p></div><div class=\"flex gap-3\"><div class=\"mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-charcoal/10\"><span class=\"text-xs text-charcoal\">2</span></div><p class=\"text-[15px] leading-relaxed text-muted\">We act as your agent throughout the process, make it easy for you to report your hours and get paid. We don&#x27;t offer clients &#x27;2 Weeks Satisfaction Guaranteed&#x27; because that&#x27;s code for &#x27;clients can choose not to pay developers.&#x27; Because of that we always hold client funds in escrow to make sure you&#x27;re never at risk.</p></div><div class=\"py-2\"></div><div class=\"flex gap-3\"><div class=\"mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-mint-deep text-white\"><span class=\"text-xs\">3</span></div><p class=\"text-[15px] leading-relaxed text-muted\">JetBridge is an invite-only developer network, so only engineers contacted by our recruiting team can join.</p></div><p class=\"text-[15px] leading-relaxed text-muted pl-8\">We generate clients through our decades-long networks in San Francisco and New York, and our vibe coding platform for doctors &amp; healthcare networks which is steadily growing in users.</p><div class=\"rounded-lg bg-surface/50 p-4\"><p class=\"text-[15px] leading-relaxed text-muted\">Developers never pay to be on JetBridge. Clients pay us a 19%+ fee for accessing our private network and our recruitment &amp; technical advisory services. We also charge doctors and hospital networks for tokens used on our vibe coding platform.</p></div><p class=\"text-[15px] leading-relaxed text-muted\">Many client projects, but not all, will be in healthcare because of the popularity of our vibe coding platform for doctors. Some projects will be part time, or weekly, or fulltime permanent (a recruiter will always detail you the options and try and make as flexible arrangements with clients on your behalf).</p><div class=\"rounded-lg border border-mint-deep/30 bg-mint-soft/20 p-4\"><p class=\"text-[15px] leading-relaxed text-charcoal\">For our many happy clients who are delighted with the quality of real engineers in our network, we have negotiated for pay raises, annual bonuses, stock equity grants and even visa sponsorship on behalf of developers.</p></div><div class=\"pt-2 flex items-center gap-3 text-sm text-muted\"><div class=\"flex gap-1\"><span class=\"text-yellow-500\">★</span><span class=\"text-yellow-500\">★</span><span class=\"text-yellow-500\">★</span><span class=\"text-yellow-500\">★</span><span class=\"text-yellow-500\">★</span></div><span class=\"text-gray\">|</span><span>JetBridge has been in business since 2016 with 4.5 stars from developers on Glassdoor and 5 stars from clients on Clutch. We also host hackathons and developer workshops on AI/ML/Data across LATAM and CEE.</span></div></div></div><div id=\"apply\" class=\"stagger lg:sticky lg:top-8\"><div class=\"rounded-card bg-card p-6 shadow-e2 sm:p-8\"><div class=\"mb-6\"><h3 class=\"font-display text-lg font-semibold text-charcoal\">Join Our Network</h3><p class=\"mt-1 text-sm text-muted\">Apply in 3-5 mins</p></div><form class=\"space-y-4\"><input type=\"text\" tabindex=\"-1\" autoComplete=\"off\" class=\"hidden\" aria-hidden=\"true\" name=\"website\" value=\"\"/><div><label for=\"fullname\" class=\"mb-1.5 block text-xs font-medium text-charcoal\">Full Name</label><input type=\"text\" id=\"fullname\" placeholder=\"John Doe\" class=\"w-full rounded-input bg-surface px-4 py-2.5 text-sm text-charcoal placeholder:text-gray focus:outline-none focus:ring-2 focus:ring-mint-deep/20\" value=\"\"/></div><div><label for=\"email\" class=\"mb-1.5 block text-xs font-medium text-charcoal\">Email</label><input type=\"email\" id=\"email\" placeholder=\"you@example.com\" class=\"w-full rounded-input bg-surface px-4 py-2.5 text-sm text-charcoal placeholder:text-gray focus:outline-none focus:ring-2 focus:ring-mint-deep/20\" value=\"\"/></div><div><label for=\"linkedin\" class=\"mb-1.5 block text-xs font-medium text-charcoal\">LinkedIn URL</label><input type=\"url\" id=\"linkedin\" placeholder=\"https://linkedin.com/in/username\" class=\"w-full rounded-input bg-surface px-4 py-2.5 text-sm text-charcoal placeholder:text-gray focus:outline-none focus:ring-2 focus:ring-mint-deep/20\" value=\"\"/></div><div><label for=\"github\" class=\"mb-1.5 block text-xs font-medium text-charcoal\">GitHub URL <span class=\"text-gray font-normal\">(optional)</span></label><input type=\"url\" id=\"github\" placeholder=\"https://github.com/username\" class=\"w-full rounded-input bg-surface px-4 py-2.5 text-sm text-charcoal placeholder:text-gray focus:outline-none focus:ring-2 focus:ring-mint-deep/20\" value=\"\"/></div><div class=\"grid gap-4 sm:grid-cols-2\"><div><label for=\"experience\" class=\"mb-1.5 block text-xs font-medium text-charcoal\">Years of Experience</label><select id=\"experience\" class=\"w-full rounded-input bg-surface px-4 py-2.5 text-sm text-charcoal focus:outline-none focus:ring-2 focus:ring-mint-deep/20\"><option value=\"\" selected=\"\">Select level</option><option value=\"5-8 years\">5-8 years</option><option value=\"8-12 years\">8-12 years</option><option value=\"12+ years\">12+ years</option><option value=\"Staff+ / Principal\">Staff+ / Principal</option></select></div><div><label for=\"timezone\" class=\"mb-1.5 block text-xs font-medium text-charcoal\">Timezone</label><select id=\"timezone\" class=\"w-full rounded-input bg-surface px-4 py-2.5 text-sm text-charcoal focus:outline-none focus:ring-2 focus:ring-mint-deep/20\"><option value=\"\" selected=\"\">Select timezone</option><option value=\"GMT-8 (Pacific)\">GMT-8 (Pacific)</option><option value=\"GMT-7 (Mountain)\">GMT-7 (Mountain)</option><option value=\"GMT-6 (Central)\">GMT-6 (Central)</option><option value=\"GMT-5 (Eastern)\">GMT-5 (Eastern)</option><option value=\"GMT+0 (UK)\">GMT+0 (UK)</option><option value=\"GMT+1 (Central Europe)\">GMT+1 (Central Europe)</option><option value=\"GMT+2 (Eastern Europe)\">GMT+2 (Eastern Europe)</option><option value=\"GMT-3 (Argentina/Brazil)\">GMT-3 (Argentina/Brazil)</option><option value=\"Other\">Other</option></select></div></div><div class=\"grid gap-4 sm:grid-cols-2\"><div><label for=\"stack\" class=\"mb-1.5 block text-xs font-medium text-charcoal\">Primary Stack</label><select id=\"stack\" class=\"w-full rounded-input bg-surface px-4 py-2.5 text-sm text-charcoal focus:outline-none focus:ring-2 focus:ring-mint-deep/20\"><option value=\"\" selected=\"\">Select stack</option><option value=\"React / Next.js\">React / Next.js</option><option value=\"Node.js / Express\">Node.js / Express</option><option value=\"Python / Django\">Python / Django</option><option value=\"Go\">Go</option><option value=\"Rust\">Rust</option><option value=\"Ruby on Rails\">Ruby on Rails</option><option value=\"Vue / Nuxt\">Vue / Nuxt</option><option value=\"Angular\">Angular</option></select></div><div><label for=\"secondary-stack\" class=\"mb-1.5 block text-xs font-medium text-charcoal\">Secondary Stack<!-- --> <span class=\"text-gray font-normal\">(optional)</span></label><input type=\"text\" id=\"secondary-stack\" placeholder=\"e.g., AWS, Kubernetes, TensorFlow\" class=\"w-full rounded-input bg-surface px-4 py-2.5 text-sm text-charcoal placeholder:text-gray focus:outline-none focus:ring-2 focus:ring-mint-deep/20\" value=\"\"/></div></div><div><label class=\"mb-2 block text-xs font-medium text-charcoal\">Rate Type</label><div class=\"flex flex-wrap gap-4\"><label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"radio\" class=\"text-mint-deep focus:ring-mint-deep\" name=\"rateType\" checked=\"\" value=\"hourly\"/><span class=\"text-sm text-charcoal\">By the hour</span></label><label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"radio\" class=\"text-mint-deep focus:ring-mint-deep\" name=\"rateType\" value=\"weekly\"/><span class=\"text-sm text-charcoal\">By the week</span></label><label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"radio\" class=\"text-mint-deep focus:ring-mint-deep\" name=\"rateType\" value=\"monthly\"/><span class=\"text-sm text-charcoal\">By the month</span></label><label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"radio\" class=\"text-mint-deep focus:ring-mint-deep\" name=\"rateType\" value=\"fulltime\"/><span class=\"text-sm text-charcoal\">Only full-time</span></label></div></div><div class=\"grid gap-4 sm:grid-cols-2\"><div><label for=\"rate\" class=\"mb-1.5 block text-xs font-medium text-charcoal\">Target Rate</label><div class=\"relative\"><span class=\"absolute left-4 top-1/2 -translate-y-1/2 text-sm text-gray\">$</span><input type=\"number\" id=\"rate\" placeholder=\"160\" class=\"w-full rounded-input bg-surface pl-8 pr-12 py-2.5 text-sm text-charcoal placeholder:text-gray focus:outline-none focus:ring-2 focus:ring-mint-deep/20\" value=\"\